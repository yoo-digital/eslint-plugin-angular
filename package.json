{
  "name": "@yoo-digital/eslint-plugin-angular",
  "version": "4.0.0",
  "description": "Yoo Digital custom Angular ESLint plugin for enforcing boolean attribute best practices.",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "angular",
    "lint",
    "yoo-digital"
  ],
  "author": "Yoo Digital",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yoo-digital/eslint-plugin-angular.git"
  },
  "bugs": {
    "url": "https://github.com/yoo-digital/eslint-plugin-angular/issues"
  },
  "homepage": "https://github.com/yoo-digital/eslint-plugin-angular#readme",
  "peerDependencies": {
    "eslint": "^9.0.0",
    "typescript": ">=5.5.0 || ^6.0.0",
    "@angular-eslint/eslint-plugin": ">=19.0.0",
    "@angular-eslint/template-parser": ">=19.0.0"
  },
  "devDependencies": {
    "typescript": "^6.0.0",
    "@typescript-eslint/utils": "^8.61.0",
    "eslint": "^9.39.0",
    "@angular-eslint/eslint-plugin": "^22.0.0",
    "@angular-eslint/template-parser": "^22.0.0",
    "@types/node": "^20.11.0"
  }
}
